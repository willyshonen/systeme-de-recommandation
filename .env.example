# ─────────────────────────────────────────────────────────────────────────────
# .env.example — MEL Recommender
# Copier ce fichier en .env et remplir les valeurs avant de lancer docker compose
#
#   cp .env.example .env
#   nano .env
#   docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────


# ── API ───────────────────────────────────────────────────────────────────────

# Clé secrète pour l'endpoint POST /reload (rechargement des modèles sans restart)
# OBLIGATOIRE en production. Générer une valeur aléatoire longue :
#     openssl rand -hex 32
#
# On ne met ici AUCUNE valeur par défaut volontairement : un placeholder
# lisible (« changeme ») finit toujours par être celui qu'on laisse en
# production, et il se retrouve publié avec ce fichier. La ligne est vide.
#
# Conséquence à connaître : sans RELOAD_SECRET, l'endpoint POST /reload est
# OUVERT à quiconque peut joindre l'API (comportementTests => local). Sur une
# machine exposée, une valeur vide n'est pas acceptable — l'API est alors
# rechargable par n'importe qui, ce qui suffit à la déstabiliser.
#
# Docker Compose a été corrigé pour ne PLUS fournir de valeur de repli : il
# transmettait « mel-reload-secret », un secret publié dans ce dépôt, alors
# qu'un .env absent ou mal orthographié suffisait à l'activer.
RELOAD_SECRET=

# ⚠ Si vous copiez ce fichier depuis un .env existant, vérifiez que votre
# RELOAD_SECRET réel n'est PAS réutilisé tel quel ailleurs : il est alors
# public. Générez-en un nouveau.

# Interface exposant le port de l'API. Laisser 127.0.0.1 en production :
# melcameroun passe alors par un reverse proxy (nginx/Caddy) qui termine le TLS.
# Ne mettre 0.0.0.0 que pour un test ponctuel.
API_BIND=127.0.0.1

# Origines front autorisées, séparées par des virgules (CORS).
# Laisser vide = melcameroun.com + localhost (valeurs par défaut du code).
# Exemple : CORS_ORIGINS=https://www.melcameroun.com,https://melcameroun.com
CORS_ORIGINS=


# ── Connexion MySQL (production) ──────────────────────────────────────────────
# Laisser MYSQL_HOST vide en développement (le pipeline utilisera le dump SQL local)
# En production, renseigner les informations de connexion à la BDD MEL Cameroun

MYSQL_HOST=
# MYSQL_HOST=db.melcameroun.com

MYSQL_PORT=3306
MYSQL_DB=mel_cameroun
MYSQL_USER=mel_readonly
MYSQL_PASSWORD=


# ── Retrain automatique ───────────────────────────────────────────────────────

# Politique du modèle. Les deux valeurs n'ont pas les mêmes conséquences, et
# ce n'est pas un réglage anodin.

# ALPHA = poids du SVD dans le score hybride (0 = purement content-based,
# 1 = purement SVD). 0.6 est le défaut du code mais N'EST PAS VALIDÉ : sur le
# jeu synthétique comme sur le jeu réel, le modèle hybride n'améliore pas la
# baseline de popularité. Ne pas le présenter comme un réglage optimal.
ALPHA=0.6

# ITEM_SPACE = catégories couvertes par le modèle.
#   interactions (défaut, recommandé) : uniquement les catégories ayant déjà une
#     interaction. Le modèle ne propose que du connu.
#   catalog : ajoute les catégories du catalogue possédant du stock. Gain de
#     couverture (148 → 191 articles disponibles joignables) mais ces
#     catégories sont classées par similarité de nom seule : sur le jeu réel,
#     44 % des premiers résultats et 46 % des positions du top-5 tombaient sur
#     des catégories jamais observées par aucun utilisateur.
ITEM_SPACE=interactions

# Planification cron du ré-entraînement hebdomadaire
# Format standard cron : minute heure jour_mois mois jour_semaine
# Exemples :
#   0 2 * * 0   → chaque dimanche à 2h du matin (défaut)
#   0 3 * * *   → chaque jour à 3h du matin
#   0 2 * * 1   → chaque lundi à 2h du matin
RETRAIN_SCHEDULE=0 2 * * 0

# Mettre à 1 pour lancer un retrain immédiatement au démarrage du container scheduler
# Utile lors du premier déploiement pour peupler les modèles
RETRAIN_ON_START=0


# ── Notifications ─────────────────────────────────────────────────────────────
# URL d'un webhook Slack ou Discord pour recevoir les notifications après chaque retrain
# Laisser vide pour désactiver les notifications
#
# Trois statuts possibles :
#   ✅ success  → ré-entraînement et rechargement OK
#   ⚠️ warning  → pipeline OK, mais le NDCG a RÉGRESSIONÉ par rapport au modèle
#                 précédent. Le modèle neuf est malgré tout déployé (choix
#                 explicite) : cette alerte est le seul signal qui le signale.
#   ❌ failure  → l'étape a échoué, rien n'a été déployé
#
# Slack   : https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXX
# Discord : https://discord.com/api/webhooks/000000000000/XXXXXXXXXXXXXXXX
NOTIFY_WEBHOOK=


# ── MLflow ────────────────────────────────────────────────────────────────────
# URI du serveur MLflow pour le tracking des expériences
#
# En local (hors Docker) → SQLite local :
MLFLOW_TRACKING_URI=sqlite:///mlflow-data/mlflow.db
#
# En production avec docker compose → décommenter la ligne ci-dessous
# et commenter la ligne SQLite ci-dessus :
# MLFLOW_TRACKING_URI=http://mlflow:5000


# ── Chemins (généralement pas besoin de modifier) ─────────────────────────────
DATA_DIR=data/raw
MODELS_DIR=models
